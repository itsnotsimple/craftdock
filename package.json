{
  "name": "minecraft-server-manager",
  "version": "2.1.0",
  "description": "Personal Minecraft Server Host & Manager for Windows and Mac",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --target=node20 --outfile=dist-electron/main.js --external:electron",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node20 --outfile=dist-electron/preload.js --external:electron",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dev:main": "esbuild src/main/main.ts --bundle --platform=node --target=node20 --outfile=dist-electron/main.js --external:electron --watch",
    "dev:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node20 --outfile=dist-electron/preload.js --external:electron --watch",
    "dev:renderer": "vite",
    "dev": "concurrently -k \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\" \"wait-on tcp:5173 && electron .\""
  },
  "build": {
    "appId": "com.craftdock.minecraftservermanager",
    "productName": "CraftDock",
    "directories": {
      "output": "dist_release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CraftDock"
    }
  },
  "keywords": [
    "minecraft",
    "server",
    "manager",
    "host",
    "papermc",
    "fabric"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
