{
  "name": "craftdock",
  "version": "3.4.0",
  "description": "Personal Minecraft Server Host & Manager for Windows and Mac",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --target=node20 --outfile=dist-electron/main.js --external:electron",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node20 --outfile=dist-electron/preload.js --external:electron",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dev:main": "esbuild src/main/main.ts --bundle --platform=node --target=node20 --outfile=dist-electron/main.js --external:electron --watch",
    "dev:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node20 --outfile=dist-electron/preload.js --external:electron --watch",
    "dev:renderer": "vite",
    "predev": "node scripts/brand-electron.cjs",
    "dev": "concurrently -k \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\" \"wait-on tcp:5173 && node scripts/launch-electron.cjs\""
  },
  "build": {
    "appId": "com.craftdock.minecraftservermanager",
    "productName": "CraftDock",
    "directories": {
      "output": "dist_release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "artifactName": "CraftDock-${version}-Windows-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "resources/icon.icns",
      "artifactName": "CraftDock-${version}-macOS-${arch}.${ext}"
    },
    "dmg": {
      "title": "Install CraftDock",
      "icon": "resources/icon.icns",
      "iconSize": 128,
      "background": "resources/dmg-background.png",
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      },
      "artifactName": "CraftDock-${version}-macOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CraftDock"
    }
  },
  "keywords": [
    "minecraft",
    "server",
    "manager",
    "host",
    "papermc",
    "fabric"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
